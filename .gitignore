# ==============================================================================
# Guffy / Job-Hunt Git Ignore Rules
# Protects personal data, credentials, local databases, and temporary artifacts
# ==============================================================================

# Personal Candidate Profiles & Resumes (CRITICAL: Do NOT commit personal data)
profile.yaml
profile.yml
data/resumes/
resumes/
*.pdf
*.docx
*.doc

# Databases & Runtime State
data/*.db
data/*.sqlite
data/*.sqlite3
data/schedules.json
*.db
*.sqlite
*.sqlite3

# Screenshots, Automation Artifacts & Browser Profiles
staging_screenshots/
data/screenshots/
screenshots/
test_browser_profile/
.browser_profile/
browser_profile/

# Environment Variables & Secrets
.env
.env.*
!.env.example
secrets.yaml
secrets.json

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Logs & Diagnostics
*.log
logs/

# IDE / Editor configuration
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
